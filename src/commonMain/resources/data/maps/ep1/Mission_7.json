yers": [{"depth": 0, "reference": 1}]}, {"c": 12, "r": 12, "layers": [{"depth": 0, "reference": 0}]}, {"c": 13, "r": 12, "layers": [{"depth": 0, "reference": 44}]}, {"c": 14, "r": 12, "layers": [{"depth": 0, "reference": 42}]}, {"c": 15, "r": 12, "layers": [{"depth": 0, "reference": 42}]}, {"c": 16, "r": 12, "layers": [{"depth": 0, "reference": 42}]}, {"c": 17, "r": 12, "layers": [{"depth": 0, "reference": 39}]}, {"c": 18, "r": 12, "layers": [{"depth": 0, "reference": 2}, {"depth": 1, "reference": 48}]}, {"c": 19, "r": 12, "layers": [{"depth": 0, "reference": 0}]}, {"c": 20, "r": 12, "layers": [{"depth": 0, "reference": 0}, {"depth": 2, "reference": 61}]}, {"c": 21, "r": 12, "layers": [{"depth": 0, "reference": 2}]}], "script": {"state": {}, "units": [], "structures": [], "events": [{"conditions": [{"type": "startGame"}], "responses": [{"type": "disableControllers", "disable": true}, {"type": "disableUnit", "disable": true, "controller": 0, "unit": "Stealth Tank"}, {"type": "chat", "sender": "CAPTAIN TUCKER", "message": "We're in the clear.", "avatar": "tucker", "color": "FFFF0000"}, {"type": "chat", "sender": "CAPTAIN ARGENT", "message": "Well, we're out of the forest at least.  Last I checked we're still running from a pantload of invisible tanks. Oh, and look, there's a hostile navy here to greet us!", "avatar": "argent", "color": "FFFF0000"}, {"type": "chat", "sender": "CAPTAIN DURAND", "message": "Tucker!  Glad you could make it. I finally gave up on fixing my ships. I captured this Warfactory on the coast to build a makeshift navy for myself.", "avatar": "durand", "color": "FFFF0000"}, {"type": "chat", "sender": "CAPTAIN TUCKER", "message": "Very resourceful, Durand. Glad to have you with us, and just in time, too. We're going to need your naval prowess.", "avatar": "tucker", "color": "FFFF0000"}, {"type": "chat", "sender": "CAPTAIN ARGENT", "message": "What a convenient spot for this Warfactory, too. Right where we popped out from the woods on the run from a legion of invisible tanks.", "avatar": "argent", "color": "FFFF0000"}, {"type": "chat", "sender": "CAPTAIN DURAND", "message": "I know, I couldn't have planned it better myself. Looks like not everything went Mullen's way today.", "avatar": "durand", "color": "FFFF0000"}, {"type": "chat", "sender": "CAPTAIN ARGENT", "message": "Hmmm... I'm not so sure about that...", "avatar": "argent", "color": "FFFF0000"}, {"type": "disableControllers", "disable": false}]}, {"conditions": [{"type": "endGame", "player": 1, "victory": false}], "responses": [{"type": "chat", "sender": "MULLEN", "message": "Well, no one's here. That's great. The party's over. Now what am I supposed to do with all these tanks?", "avatar": "mullen", "color": "FFFF0000"}]}, {"conditions": [{"type": "endGame", "player": 1, "victory": true, "satisfied": true}], "responses": [{"type": "chat", "sender": "CAPTAIN TUCKER", "message": "Did you recognize those enemy ships, Durand? They weren't Northern Federation.", "avatar": "tucker", "color": "FFFF0000"}, {"type": "chat", "sender": "CAPTAIN DURAND", "message": "Those were Akadian vessels. No doubt.", "avatar": "durand", "color": "FFFF0000"}, {"type": "chat", "sender": "CAPTAIN TUCKER", "message": "I didn't think they still had a military presence, not to mention a full-fledged navy.  Those ships looked to be in top condition.", "avatar": "tucker", "color": "FFFF0000"}, {"type": "chat", "sender": "CAPTAIN DURAND", "message": "If Mullen is in league with the Akadians, then this situation has just gotten very bad.", "avatar": "durand", "color": "FFFF0000"}, {"type": "chat", "sender": "CAPTAIN ARGENT", "message": "Just gotten?! I knew all along this was worse than just some yokels with pointy sticks and a bad attitude!", "avatar": "argent", "color": "FFFF0000"}, {"type": "chat", "sender": "CAPTAIN TUCKER", "message": "The Akadians are all supposed to be scattered to the winds.  They were dismantled after the Offensive.  Do you think Mullen has been selling stolen Northern Federation tech to them?", "avatar": "tucker", "color": "FFFF0000"}, {"type": "chat", "sender": "CAPTAIN ARGENT", "message": "Invisible war-mongering Akadians?  That's just perfect.", "avatar": "argent", "color": "FFFF0000"}, {"type": "chat", "sender": "CAPTAIN TUCKER", "message": "Durand, can you figure out where those ships were docked?", "avatar": "tucker", "color": "FFFF0000"}, {"type": "chat", "sender": "CAPTAIN DURAND", "message": "Could only be one spot.  There's a group of islands north of here with an old port among them large enough to station a fleet of that size.", "avatar": "durand", "color": "FFFF0000"}, {"type": "chat", "sender": "CAPTAIN TUCKER", "message": "A chain of islands?  Warm up the transports, we've got some island hopping to do.", "avatar": "tucker", "color": "FFFF0000"}]}]}}