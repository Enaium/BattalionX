disable": false}]}, {"conditions": [{"type": "endGame", "player": 1, "victory": false}], "responses": [{"type": "disableControllers", "disable": true}, {"type": "chat", "sender": "GENERAL DURAND", "message": "No one can stand against the spider tank. I love a good ambush.", "avatar": "evil_durand", "color": "FF0000FF"}, {"type": "disableControllers", "disable": false}]}, {"conditions": [{"type": "endGame", "player": 1, "victory": true}], "responses": [{"type": "disableControllers", "disable": true}, {"type": "chat", "sender": "CAPTAIN TUCKER", "message": "I hate spider tanks. They give me the willies. Anyone else?", "avatar": "tucker", "color": "FFFF0000"}, {"type": "chat", "sender": "COMMANDER YURIK", "message": "I do not fear anything that I can defeat in battle.", "avatar": "yurik", "color": "FF00FF00"}, {"type": "chat", "sender": "CAPTAIN TUCKER", "message": "Okay. Guess that's just me then.", "avatar": "tucker", "color": "FF00FF00"}, {"type": "chat", "sender": "AKADIAN SOLDIER", "message": "Sir. The spider tank outpost has been defeated, sir.", "avatar": "Akadian_3", "color": "FF0000FF"}, {"type": "chat", "sender": "GENERAL DURAND", "message": "The spider tanks performed admirably. Too bad they were not enough to stop them cold. Prepare the War Machines. Have the spies reported back in?", "avatar": "evil_durand", "color": "FF0000FF"}, {"type": "chat", "sender": "AKADIAN SOLDIER", "message": "They have sir. All missions report success.", "avatar": "Akadian_3", "color": "FF0000FF"}, {"type": "chat", "sender": "GENERAL DURAND", "message": "Excellent. I'm waiting for you Tucker, old friend. Don't take too long...", "avatar": "evil_durand", "color": "FF0000FF"}, {"type": "disableControllers", "disable": false}]}]}}