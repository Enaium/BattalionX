r": 2, "enable": true, "unit": "Condor Bomber"}, {"type": "enableUnit", "player": 2, "enable": true, "unit": "Raptor Fighter"}, {"type": "enableUnit", "player": 2, "enable": true, "unit": "Hunter Support"}, {"type": "enableUnit", "player": 2, "enable": true, "unit": "Intrepid"}, {"type": "enableUnit", "player": 2, "enable": true, "unit": "Corvette Fighter"}, {"type": "enableUnit", "player": 2, "enable": true, "unit": "Battlecruiser"}, {"type": "enableUnit", "player": 2, "enable": true, "unit": "U-Boat"}, {"type": "chat", "sender": "CAPTAIN TUCKER", "message": "This is madness.", "avatar": "tucker", "color": "FFFF0000"}, {"type": "chat", "sender": "CAPTAIN ARGENT", "message": "No. This... is... SP\ufffdAR-", "avatar": "argent", "color": "FFFF0000"}, {"type": "chat", "sender": "CAPTAIN TUCKER", "message": "Not now Argent.", "avatar": "tucker", "color": "FFFF0000"}, {"type": "chat", "sender": "CAPTAIN ARGENT", "message": "Oh, come on, man!", "avatar": "argent", "color": "FFFF0000"}, {"type": "chat", "sender": "COMMANDER YURIK", "message": "We have no choice but to advance. If we retreat now, Durand will have time to regain his power and to escape. We will never be free of him unless we strike.", "avatar": "yurik", "color": "FF00FF00"}, {"type": "chat", "sender": "CAPTAIN TUCKER", "message": "We'll never be able to breach these defenses. There are simply too many, far more than our scouts had estimated.", "avatar": "tucker", "color": "FFFF0000"}, {"type": "chat", "sender": "COMMANDER YURIK", "message": "Then leave. I do not fear death in the service of my nation.", "avatar": "yurik", "color": "FF00FF00"}, {"type": "chat", "sender": "CAPTAIN ARGENT", "message": "Don't be too hasty guys. Look who I found lurking outside our base. It's my old buddy!", "avatar": "argent", "color": "FF00FF00"}, {"type": "chat", "sender": "LIEUTENANT HAYNE", "message": "I wasn't lurking. I came here to help. There is a route. A mountain pass across the lake. It's poorly defended. The terrain there won't support the heavier units. I can take you there.", "avatar": "hayne", "color": "FF0000FF"}, {"type": "chat", "sender": "CAPTAIN ARGENT", "message": "I don't trust him. I say we ice this greaseball.", "avatar": "argent", "color": "FFFF0000"}, {"type": "chat", "sender": "CAPTAIN TUCKER", "message": "Take it easy Argent. I think he's really here to help.", "avatar": "tucker", "color": "FFFF0000"}, {"type": "chat", "sender": "LIEUTENANT HAYNE", "message": "He has to be stopped. I don't... I don't think I can do it alone. I want you to help me. My father died in those strikes on Akadian bases that Durand ordered. I have to help put him to rest.", "avatar": "hayne", "color": "FF0000FF"}, {"type": "chat", "sender": "COMMANDER YURIK", "message": "We move immediately.", "avatar": "yurik", "color": "FF00FF00"}, {"type": "chat", "sender": "CAPTAIN ARGENT", "message": "You trust him?", "avatar": "argent", "color": "FFFF0000"}, {"type": "chat", "sender": "COMMANDER YURIK", "message": "You see madness and betrayal behind his eyes, but I see the devotion of a man consumed by his cause. Our vengeance will be his vengeance.", "avatar": "yurik", "color": "FF00FF00"}, {"type": "disableControllers", "disable": false}]}, {"conditions": [{"type": "endGame", "player": 1, "victory": true}], "responses": [{"type": "disableControllers", "disable": true}, {"type": "chat", "sender": "COMMANDER YURIK", "message": "We cannot fail here, Tucker. This battle means too much to our people. If you or Argent do not feel up to the challenge that faces us, I cannot allow you to join us.", "avatar": "yurik", "color": "FF00FF00"}, {"type": "chat", "sender": "CAPTAIN TUCKER", "message": "We're all ready. Durand has to be stopped.", "avatar": "tucker", "color": "FFFF0000"}, {"type": "chat", "sender": "CAPTAIN ARGENT", "message": "I dunno. I AM pretty tired.", "avatar": "argent", "color": "FFFF0000"}, {"type": "chat", "sender": "CAPTAIN TUCKER", "message": "You don't get a vote.", "avatar": "tucker", "color": "FFFF0000"}, {"type": "chat", "sender": "LIEUTENANT HAYNE", "message": "Father, I will avenge you.", "avatar": "hayne", "color": "FF0000FF"}, {"type": "chat", "sender": "COMMANDER YURIK", "message": "It is settled then. At dawn, we take Durand's fortress. Prepare yourselves.", "avatar": "yurik", "color": "FF00FF00"}, {"type": "disableControllers", "disable": false}]}, {"conditions": [{"type": "endGame", "player": 1, "victory": false}], "responses": [{"type": "disableControllers", "disable": true}, {"type": "chat", "sender": "GENERAL DURAND", "message": "Oooooh. So close. And yet, so very far away. Maybe next time, team.", "avatar": "evil_durand", "color": "FF0000FF"}, {"type": "disableControllers", "disable": false}]}]}}