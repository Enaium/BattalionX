onses": [{"type": "chat", "sender": "GENERAL PEARL", "message": "You probably can't save the exposed War Machine, but you should still see if you can slow down the enemy's advance on your protected War Machine.", "avatar": "pearl", "color": "FFFF0000"}, {"type": "chat", "sender": "GENERAL PEARL", "message": "Remember to use your War Machine to extract resources from the Ore Deposits.", "avatar": "pearl", "color": "FFFF0000"}]}, {"conditions": [{"type": "endGame", "player": 1, "victory": true}], "responses": [{"type": "chat", "sender": "GENERAL PEARL", "message": "I bet that was stressful. Nice job! We've only got one last lesson to go through.", "avatar": "pearl", "color": "FFFF0000"}]}]}}