ce": 28}]}, {"c": 10, "r": 2, "layers": [{"depth": 0, "reference": 10}]}, {"c": 10, "r": 3, "layers": [{"depth": 0, "reference": 4}]}, {"c": 10, "r": 4, "layers": [{"depth": 0, "reference": 3}]}, {"c": 10, "r": 5, "layers": [{"depth": 0, "reference": 33}]}, {"c": 10, "r": 6, "layers": [{"depth": 0, "reference": 14}, {"depth": 2, "reference": 15}]}, {"c": 10, "r": 7, "layers": [{"depth": 0, "reference": 32}]}, {"c": 10, "r": 8, "layers": [{"depth": 0, "reference": 3}]}, {"c": 10, "r": 9, "layers": [{"depth": 0, "reference": 2}]}, {"c": 10, "r": 10, "layers": [{"depth": 0, "reference": 4}]}, {"c": 11, "r": 0, "layers": [{"depth": 0, "reference": 4}, {"depth": 2, "reference": 20}]}, {"c": 11, "r": 1, "layers": [{"depth": 0, "reference": 4}]}, {"c": 11, "r": 2, "layers": [{"depth": 0, "reference": 2}]}, {"c": 11, "r": 3, "layers": [{"depth": 0, "reference": 0}]}, {"c": 11, "r": 4, "layers": [{"depth": 0, "reference": 4}]}, {"c": 11, "r": 5, "layers": [{"depth": 0, "reference": 4}]}, {"c": 11, "r": 6, "layers": [{"depth": 0, "reference": 2}]}, {"c": 11, "r": 7, "layers": [{"depth": 0, "reference": 33}]}, {"c": 11, "r": 8, "layers": [{"depth": 0, "reference": 16}]}, {"c": 11, "r": 9, "layers": [{"depth": 0, "reference": 14}, {"depth": 2, "reference": 15}]}, {"c": 11, "r": 10, "layers": [{"depth": 0, "reference": 16}]}, {"c": 12, "r": 0, "layers": [{"depth": 0, "reference": 31}]}, {"c": 12, "r": 1, "layers": [{"depth": 0, "reference": 0}]}, {"c": 12, "r": 2, "layers": [{"depth": 0, "reference": 7}]}, {"c": 12, "r": 3, "layers": [{"depth": 0, "reference": 8}, {"depth": 2, "reference": 5}]}, {"c": 12, "r": 4, "layers": [{"depth": 0, "reference": 8}, {"depth": 2, "reference": 5}]}, {"c": 12, "r": 5, "layers": [{"depth": 0, "reference": 8}]}, {"c": 12, "r": 6, "layers": [{"depth": 0, "reference": 10}]}, {"c": 12, "r": 7, "layers": [{"depth": 0, "reference": 4}]}, {"c": 12, "r": 8, "layers": [{"depth": 0, "reference": 0}]}, {"c": 12, "r": 9, "layers": [{"depth": 0, "reference": 7}]}, {"c": 12, "r": 10, "layers": [{"depth": 0, "reference": 8}]}, {"c": 13, "r": 0, "layers": [{"depth": 0, "reference": 4}]}, {"c": 13, "r": 1, "layers": [{"depth": 0, "reference": 4}]}, {"c": 13, "r": 2, "layers": [{"depth": 0, "reference": 2}]}, {"c": 13, "r": 3, "layers": [{"depth": 0, "reference": 4}]}, {"c": 13, "r": 4, "layers": [{"depth": 0, "reference": 1}]}, {"c": 13, "r": 5, "layers": [{"depth": 0, "reference": 4}, {"depth": 2, "reference": 5}]}, {"c": 13, "r": 6, "layers": [{"depth": 0, "reference": 34}]}, {"c": 13, "r": 7, "layers": [{"depth": 0, "reference": 8}]}, {"c": 13, "r": 8, "layers": [{"depth": 0, "reference": 8}]}, {"c": 13, "r": 9, "layers": [{"depth": 0, "reference": 25}]}, {"c": 13, "r": 10, "layers": [{"depth": 0, "reference": 4}]}], "script": {"state": {}, "units": [], "structures": [], "events": [{"conditions": [{"type": "endGame", "player": 1, "victory": false}], "responses": [{"type": "disableControllers", "disable": true}, {"type": "chat", "sender": "CAPTAIN ARGENT", "message": "I thought he was supposed to be the big Akadian tough guy? Man, whatever to that.", "avatar": "argent", "color": "FFFF0000"}, {"type": "disableControllers", "disable": false}]}, {"conditions": [{"type": "startGame"}], "responses": [{"type": "disableMorale", "disable": true}, {"type": "disableControllers", "disable": true}, {"type": "chat", "sender": "CAPTAIN ARGENT", "message": "Back for more, eh?", "avatar": "argent", "color": "FFFF0000"}, {"type": "chat", "sender": "LIEUTENANT HAYNE", "message": "I defeated you before, and I will do so again.", "avatar": "hayne", "color": "FF0000FF"}, {"type": "chat", "sender": "CAPTAIN ARGENT", "message": "I never was very good at keeping track of the score.", "avatar": "argent", "color": "FFFF0000"}, {"type": "chat", "sender": "LIEUTENANT HAYNE", "message": "Will you surrender the War Machines to me, or do I have to beat you until you cry for your mother?", "avatar": "hayne", "color": "FF0000FF"}, {"type": "chat", "sender": "CAPTAIN ARGENT", "message": "Are you for real? Who talks like that?", "avatar": "argent", "color": "FFFF0000"}, {"type": "chat", "sender": "LIEUTENANT HAYNE", "message": "Who talks like that? I am the most decorated commander in Akadian history... for my age. They call me the Akadian Avenger, the Terror of the Battlefield, the Northern Federation Nemesis...", "avatar": "hayne", "color": "FF0000FF"}, {"type": "chat", "sender": "CAPTAIN ARGENT", "message": "Hey now. Let's not be too hasty about this battle thing. I was just... ummm... you have a... wonderful speaking voice.", "avatar": "argent", "color": "FFFF0000"}, {"type": "chat", "sender": "CAPTAIN TUCKER", "message": "If you want the War Machine, you'll have to come take it. Unless you're afraid you can't handle the firepower.", "avatar": "tucker", "color": "FFFF0000"}, {"type": "chat", "sender": "CAPTAIN ARGENT", "message": "...pssst... stop making him angry!", "avatar": "argent", "color": "FFFF0000"}, {"type": "chat", "sender": "LIEUTENANT HAYNE", "message": "We are going to crush you all. There will be parades in our honor! We'll be heroes! And you, Tucker, you'll be dead.", "avatar": "hayne", "color": "FF0000FF"}, {"type": "disableControllers", "disable": false}]}, {"conditions": [{"type": "endGame", "player": 1, "victory": true}], "responses": [{"type": "disableControllers", "disable": true}, {"type": "chat", "sender": "CAPTAIN TUCKER", "message": "You're good, Hayne. It's too bad you can't see the General for what he is.", "avatar": "tucker", "color": "FFFF0000"}, {"type": "chat", "sender": "LIEUTENANT HAYNE", "message": "What do you know of the General? He is a hero and he crushed your forces after making a fool of you.", "avatar": "hayne", "color": "FF0000FF"}, {"type": "chat", "sender": "CAPTAIN TUCKER", "message": "I'd love to stay and educate you on what we've learned about your General Durand since he betrayed us, but elaborate military plans call.", "avatar": "tucker", "color": "FFFF0000"}, {"type": "chat", "sender": "LIEUTENANT HAYNE", "message": "Stand and fight, coward!", "avatar": "hayne", "color": "FF0000FF"}, {"type": "chat", "sender": "CAPTAIN ARGENT", "message": "Can't. We've got haircuts later.", "avatar": "argent", "color": "FFFF0000"}, {"type": "chat", "sender": "MAJOR MAYJOR", "message": "Lieutenant! Uncle Durand is on comms. There's a vein popping out of his forehead.", "avatar": "mayjor", "color": "FF0000FF"}, {"type": "chat", "sender": "LIEUTENANT HAYNE", "message": "It's time for us to begin basking in the glow of our glory, Major.", "avatar": "hayne", "color": "FF0000FF"}, {"type": "chat", "sender": "LIEUTENANT HAYNE", "message": "Hello, sir! We have defeated the Federation once again and the engineers should now have enough parts to reconstruct and produce the War Machine. Akadia forever!", "avatar": "hayne", "color": "FF0000FF"}, {"type": "chat", "sender": "GENERAL DURAND", "message": "War Machine? Who cares about the War Machine anymore? We have something much more pressing to deal with, Lieutenant. The Dragoons have returned.", "avatar": "evil_durand", "color": "FF0000FF"}, {"type": "chat", "sender": "MAJOR MAYJOR", "message": "Dragons?!", "avatar": "mayjor", "color": "FF0000FF"}, {"type": "chat", "sender": "LIEUTENANT HAYNE", "message": "The Dragoons... all these years later. They've finally returned to finish what they started.", "avatar": "hayne", "color": "FF0000FF"}, {"type": "chat", "sender": "MAJOR MAYJOR", "message": "Scales and wings and claws and fire! We're doomed!", "avatar": "mayjor", "color": "FF0000FF"}, {"type": "chat", "sender": "GENERAL DURAND", "message": "Shut up, nephew! Clearly, the Dragoons want the chance to finally destroy the Akadian people. You must stop them.", "avatar": "evil_durand", "color": "FF0000FF"}, {"type": "chat", "sender": "LIEUTENANT HAYNE", "message": "I will, sir. I have a score to settle with the Dragoons. My father was killed during the raid that sparked off the Dragoon War.", "avatar": "hayne", "color": "FF0000FF"}, {"type": "chat", "sender": "GENERAL DURAND", "message": "If they have joined forces with Captain Tucker, this is a dangerous combination. We have no idea what sorts of weaponry that the Dragoons will be bringing with them.", "avatar": "evil_durand", "color": "FF0000FF"}, {"type": "chat", "sender": "LIEUTENANT HAYNE", "message": "Whatever they may have... it will not be enough.", "avatar": "hayne", "color": "FF0000FF"}, {"type": "chat", "sender": "MAJOR MAYJOR", "message": "What can we use to defeat dragons?! Unicorns! We'll ride unicorns into battle. Unicorns with laser missiles strapped to their backs!", "avatar": "mayjor", "color": "FF0000FF"}, {"type": "chat", "sender": "LIEUTENANT HAYNE", "message": "Mayjor, get a hold of yourself and  gather the forces. The Dragoons must be approaching over the Nithenian Sea. We strike at the Federation shipyards immediately!", "avatar": "hayne", "color": "FF0000FF"}, {"type": "disableControllers", "disable": false}]}]}}