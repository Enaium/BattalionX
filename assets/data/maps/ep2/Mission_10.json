"structures": [], "events": [{"conditions": [{"type": "endGame", "player": 1, "victory": false}], "responses": [{"type": "disableControllers", "disable": true}, {"type": "chat", "sender": "MAJOR MAYJOR", "message": "We were so close. And I hear every time someone fails a mission, a kitten gets punched in the face. Good job with that, Hayne. A kitten got punched because of you.", "avatar": "mayjor", "color": "FF0000FF"}, {"type": "disableControllers", "disable": false}]}, {"conditions": [{"type": "startGame"}], "responses": [{"type": "disableMorale", "disable": true}, {"type": "disableControllers", "disable": true}, {"type": "chat", "sender": "LIEUTENANT HAYNE", "message": "Tucker. This is the end of the line. Your troops have no other locations to run to. No other places to hide. Soon, you will finally have to admit who the superior warrior is.", "avatar": "hayne", "color": "FF0000FF"}, {"type": "chat", "sender": "CAPTAIN ARGENT", "message": "I'm sorry, were you looking for Tucker here? No one here but us Dragoons. And me.", "avatar": "argent", "color": "FFFF0000"}, {"type": "chat", "sender": "LIEUTENANT HAYNE", "message": "Don't lie to me. This is one of Tucker's tricks. Come out and fight me!", "avatar": "hayne", "color": "FF0000FF"}, {"type": "chat", "sender": "GENERAL USUL", "message": "Today we will see how you fare against me.", "avatar": "usul", "color": "FF00FF00"}, {"type": "chat", "sender": "LIEUTENANT HAYNE", "message": "Is he too much of a coward? Fine. All units, attack!", "avatar": "hayne", "color": "FF0000FF"}, {"type": "disableControllers", "disable": false}]}, {"conditions": [{"type": "endGame", "player": 1, "victory": true}], "responses": [{"type": "disableControllers", "disable": true}, {"type": "chat", "sender": "LIEUTENANT HAYNE", "message": "Victory! The Dragoons are no match for the power of Hayne! I am unstoppable! Crawl away, Captain Argent and tell that coward Tucker that I've crushed the best he had to offer me.", "avatar": "hayne", "color": "FF0000FF"}, {"type": "chat", "sender": "MAJOR MAYJOR", "message": "There's a radio transmission coming through!", "avatar": "mayjor", "color": "FF0000FF"}, {"type": "chat", "sender": "LIEUTENANT HAYNE", "message": "The General. He won't be able to punish us after he hears of our triumph here today.", "avatar": "hayne", "color": "FF0000FF"}, {"type": "chat", "sender": "GENERAL DURAND", "message": "Hayne! Our forces are under attack! It was a trap, you idiot.", "avatar": "evil_durand", "color": "FF0000FF"}, {"type": "chat", "sender": "MAJOR MAYJOR", "message": "Told you so.", "avatar": "mayjor", "color": "FF0000FF"}, {"type": "chat", "sender": "LIEUTENANT HAYNE", "message": "What are you talking about? I've destroyed their forces. Their base is in ruins around me. Akadia reigns supreme!", "avatar": "hayne", "color": "FF0000FF"}, {"type": "chat", "sender": "GENERAL DURAND", "message": "They've been baiting you! They lured you as far away from my forces as they could and then they sprang their trap. Tucker has us surrounded on all sides! I'm ordering a full retreat to Akadia!", "avatar": "evil_durand", "color": "FF0000FF"}, {"type": "chat", "sender": "LIEUTENANT HAYNE", "message": "But... but... I won! I beat them!", "avatar": "hayne", "color": "FF0000FF"}, {"type": "chat", "sender": "GENERAL DURAND", "message": "You've doomed us, Hayne! They split our forces. We're outmaneuvered and outgunned now!", "avatar": "evil_durand", "color": "FF0000FF"}, {"type": "chat", "sender": "CAPTAIN ARGENT", "message": "I think you were saying something funny about my crawling away in defeat?", "avatar": "argent", "color": "FFFF0000"}, {"type": "chat", "sender": "LIEUTENANT HAYNE", "message": "You! You'll pay for this you smart-mouthed weasel!", "avatar": "hayne", "color": "FF0000FF"}, {"type": "chat", "sender": "CAPTAIN ARGENT", "message": "Sticks and stones, sticks and stones.", "avatar": "argent", "color": "FFFF0000"}, {"type": "chat", "sender": "MAJOR MAYJOR", "message": "We have to get back and save Uncle!", "avatar": "mayjor", "color": "FF0000FF"}, {"type": "chat", "sender": "LIEUTENANT HAYNE", "message": "We will return to Akadia to defend her from our enemies... as soon as I destroy this little weakling.", "avatar": "hayne", "color": "FF0000FF"}, {"type": "chat", "sender": "CAPTAIN ARGENT", "message": "Let's do this!", "avatar": "argent", "color": "FFFF0000"}, {"type": "chat", "sender": "GENERAL USUL", "message": "Keep the Lieutenant occupied, Captain Argent. Dragoons! We rally to join Captain Tucker's forces in assaulting Akadia! The time of our vengeance is at hand!", "avatar": "usul", "color": "FF00FF00"}, {"type": "disableControllers", "disable": false}]}, {"conditions": [{"type": "startGame"}], "responses": [{"type": "disableAllUnits", "disable": true, "player": 1}, {"type": "enableUnit", "enable": true, "player": 1, "unit": "Strike Commando"}, {"type": "enableUnit", "enable": true, "player": 1, "unit": "Heavy Commando"}, {"type": "enableUnit", "enable": true, "player": 1, "unit": "Flak Tank"}, {"type": "enableUnit", "enable": true, "player": 1, "unit": "Scorpion Tank"}, {"type": "enableUnit", "enable": true, "player": 1, "unit": "Mortar Truck"}, {"type": "enableUnit", "enable": true, "player": 1, "unit": "Rocket Truck"}, {"type": "enableUnit", "enable": true, "player": 1, "unit": "Stealth Tank"}, {"type": "enableUnit", "enable": true, "player": 1, "unit": "Annihilator Tank"}, {"type": "enableUnit", "enable": true, "player": 1, "unit": "Condor Bomber"}, {"type": "enableUnit", "enable": true, "player": 1, "unit": "Spider Tank"}, {"type": "enableUnit", "enable": true, "player": 1, "unit": "Raptor Fighter"}, {"type": "enableUnit", "enable": true, "player": 1, "unit": "Hunter Support"}, {"type": "enableUnit", "enable": true, "player": 1, "unit": "Corvette Fighter"}, {"type": "enableUnit", "enable": true, "player": 1, "unit": "Battlecruiser"}, {"type": "enableUnit", "enable": true, "player": 1, "unit": "U-Boat"}, {"type": "disableAllUnits", "disable": true, "player": 2}, {"type": "enableUnit", "enable": true, "player": 2, "unit": "Strike Commando"}, {"type": "enableUnit", "enable": true, "player": 2, "unit": "Heavy Commando"}, {"type": "enableUnit", "enable": true, "player": 2, "unit": "Flak Tank"}, {"type": "enableUnit", "enable": true, "player": 2, "unit": "Scorpion Tank"}, {"type": "enableUnit", "enable": true, "player": 2, "unit": "Mortar Truck"}, {"type": "enableUnit", "enable": true, "player": 2, "unit": "Rocket Truck"}, {"type": "enableUnit", "enable": true, "player": 2, "unit": "Stealth Tank"}, {"type": "enableUnit", "enable": true, "player": 2, "unit": "Annihilator Tank"}, {"type": "enableUnit", "enable": true, "player": 2, "unit": "Condor Bomber"}, {"type": "enableUnit", "enable": true, "player": 2, "unit": "Raptor Fighter"}, {"type": "enableUnit", "enable": true, "player": 2, "unit": "Hunter Support"}, {"type": "enableUnit", "enable": true, "player": 2, "unit": "Corvette Fighter"}, {"type": "enableUnit", "enable": true, "player": 2, "unit": "Battlecruiser"}, {"type": "enableUnit", "enable": true, "player": 2, "unit": "U-Boat"}, {"type": "enableUnit", "enable": true, "player": 2, "unit": "Jammer Truck"}]}]}}