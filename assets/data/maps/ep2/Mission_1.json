"depth": 0, "reference": 11}]}, {"c": 4, "r": 8, "layers": [{"depth": 0, "reference": 23}]}, {"c": 5, "r": 8, "layers": [{"depth": 0, "reference": 11}]}, {"c": 6, "r": 8, "layers": [{"depth": 0, "reference": 11}]}, {"c": 7, "r": 8, "layers": [{"depth": 0, "reference": 32}, {"depth": 2, "reference": 9}]}, {"c": 8, "r": 8, "layers": [{"depth": 0, "reference": 2}]}, {"c": 9, "r": 8, "layers": [{"depth": 0, "reference": 1}]}, {"c": 0, "r": 9, "layers": [{"depth": 0, "reference": 5}]}, {"c": 1, "r": 9, "layers": [{"depth": 0, "reference": 2}]}, {"c": 2, "r": 9, "layers": [{"depth": 0, "reference": 2}]}, {"c": 3, "r": 9, "layers": [{"depth": 0, "reference": 2}, {"depth": 2, "reference": 9}]}, {"c": 4, "r": 9, "layers": [{"depth": 0, "reference": 23}]}, {"c": 5, "r": 9, "layers": [{"depth": 0, "reference": 2}, {"depth": 2, "reference": 9}]}, {"c": 6, "r": 9, "layers": [{"depth": 0, "reference": 2}]}, {"c": 7, "r": 9, "layers": [{"depth": 0, "reference": 2}]}, {"c": 8, "r": 9, "layers": [{"depth": 0, "reference": 1}]}, {"c": 9, "r": 9, "layers": [{"depth": 0, "reference": 5}]}], "script": {"state": {}, "units": [], "structures": [], "events": [{"conditions": [{"type": "startGame"}], "responses": [{"type": "disableMorale", "disable": true}, {"type": "disableControllers", "disable": true}, {"type": "chat", "sender": "GENERAL DURAND", "message": "It is a glorious morning, Lieutenant Hayne. Today you begin the conquest of the Northern Federation.", "avatar": "evil_durand", "color": "FF0000FF"}, {"type": "chat", "sender": "LIEUTENANT HAYNE", "message": "It is my great honor... and may I say that you could not have picked a more suitable commander for your army.", "avatar": "hayne", "color": "FF0000FF"}, {"type": "chat", "sender": "GENERAL DURAND", "message": "Clean up this riff-raff that Captain Tucker left behind. It's embarrassing to even look at their bumbling.", "avatar": "evil_durand", "color": "FF0000FF"}, {"type": "chat", "sender": "LIEUTENANT HAYNE", "message": "My battlecruiser and tanks will make short work of them, sir.", "avatar": "hayne", "color": "FF0000FF"}, {"type": "chat", "sender": "GENERAL DURAND", "message": "Make me proud, Lieutenant. It took me a great many years to set us up for this assault; I won't see it squandered.", "avatar": "evil_durand", "color": "FF0000FF"}, {"type": "chat", "sender": "LIEUTENANT HAYNE", "message": "Squandered? By me? Sir, I am the result of generations of glorious Akadian breeding! There is no one better suited to this task in all of the Akadian people, present company excluded, of course. Now... all units, engage the Federation!", "avatar": "hayne", "color": "FF0000FF"}, {"type": "disableControllers", "disable": false}]}, {"conditions": [{"type": "endGame", "player": 1, "victory": false}], "responses": [{"type": "disableControllers", "disable": true}, {"type": "chat", "sender": "GENERAL DURAND", "message": "Is this a joke? This should have been like using a rocket to swat a fly. You are a disgrace, Hayne.", "avatar": "evil_durand", "color": "FF0000FF"}, {"type": "disableControllers", "disable": false}]}, {"conditions": [{"type": "endGame", "player": 1, "victory": true}], "responses": [{"type": "disableControllers", "disable": true}, {"type": "chat", "sender": "LIEUTENANT HAYNE", "message": "This is the best the Federation has?", "avatar": "hayne", "color": "FF0000FF"}, {"type": "chat", "sender": "GENERAL DURAND", "message": "These forces were weak, and Captain Tucker was not there to lead them.", "avatar": "evil_durand", "color": "FF0000FF"}, {"type": "chat", "sender": "LIEUTENANT HAYNE", "message": "Tucker will meet the same fate as the rest.", "avatar": "hayne", "color": "FF0000FF"}, {"type": "chat", "sender": "GENERAL DURAND", "message": "You forget, Lieutenant, that I spent a good deal of time in the Federation. For years I was part of Tucker's battalion, and I know his tactics well.  The Northern Federation on the whole is undisciplined... but Tucker is a fierce enemy.", "avatar": "evil_durand", "color": "FF0000FF"}, {"type": "chat", "sender": "LIEUTENANT HAYNE", "message": "When I am finished with him, he won't even be able to remember his own name.", "avatar": "hayne", "color": "FF0000FF"}, {"type": "chat", "sender": "GENERAL DURAND", "message": "I have a mission for you, Lieutenant. I have gotten word from our advance scouts that the Northern Federation has developed a new type of military base -  a mobile structure.", "avatar": "evil_durand", "color": "FF0000FF"}, {"type": "chat", "sender": "LIEUTENANT HAYNE", "message": "I will seek out these units and destroy them, sir. Our engineers will be able to piece together the wreckage to unravel the technology used to craft them. This new weapon will be mine... erm... ours!", "avatar": "hayne", "color": "FF0000FF"}, {"type": "chat", "sender": "GENERAL DURAND", "message": "One more thing. I will be sending my nephew with you. He needs some time away from me... once and for all...", "avatar": "evil_durand", "color": "FF0000FF"}, {"type": "chat", "sender": "LIEUTENANT HAYNE", "message": "Sir?", "avatar": "hayne", "color": "FF0000FF"}, {"type": "chat", "sender": "GENERAL DURAND", "message": "To see the world, of course. He needs to get out and see the world.", "avatar": "evil_durand", "color": "FF0000FF"}, {"type": "disableControllers", "disable": false}]}]}}