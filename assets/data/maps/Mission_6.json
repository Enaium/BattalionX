rence": 0}]}, {"c": 8, "r": 14, "layers": [{"depth": 0, "reference": 21}]}, {"c": 9, "r": 14, "layers": [{"depth": 0, "reference": 29}]}], "script": {"state": {}, "units": [], "structures": [], "events": [{"conditions": [{"type": "startGame"}], "responses": [{"type": "disableMorale", "disable": true}, {"type": "disableControllers", "disable": true}, {"type": "chat", "sender": "COMMANDER YURIK", "message": "It appears that I may have been wrong about your comrade.", "avatar": "yurik", "color": "FF00FF00"}, {"type": "chat", "sender": "CAPTAIN TUCKER", "message": "Argent? What do you mean?", "avatar": "tucker", "color": "FFFF0000"}, {"type": "chat", "sender": "COMMANDER YURIK", "message": "Those ships downriver, they are commanded by Lieutenant Hayne. Since he is here and Argent is not, I can only assume that your comrade was defeated.", "avatar": "yurik", "color": "FF00FF00"}, {"type": "chat", "sender": "CAPTAIN TUCKER", "message": "There has to be some other explanation. Argent is a good soldier... and I'm sure General Pearl would have saved his sorry butt if he got into too much trouble.", "avatar": "tucker", "color": "FFFF0000"}, {"type": "chat", "sender": "COMMANDER YURIK", "message": "Hayne's troops movements are erratic. Indecisive. He is either a brilliant tactician, or...", "avatar": "yurik", "color": "FF00FF00"}, {"type": "chat", "sender": "LIEUTENANT HAYNE", "message": "Tucker! In my way again! And the Dragoons! You're all trying to steal it from me. Well you can't! I'll be the one to kill him. ME! Only me! Victory must be mine. I need to have it.", "avatar": "hayne", "color": "FF0000FF"}, {"type": "chat", "sender": "COMMANDER YURIK", "message": "... totally deranged.", "avatar": "yurik", "color": "FF00FF00"}, {"type": "chat", "sender": "CAPTAIN TUCKER", "message": "Survey says: bonkers.", "avatar": "tucker", "color": "FFFF0000"}, {"type": "chat", "sender": "COMMANDER YURIK", "message": "Hayne's units are within range. Attack, all units! We must contend with Hayne before we can handle Durand.", "avatar": "yurik", "color": "FF00FF00"}, {"type": "disableControllers", "disable": false}]}, {"conditions": [{"type": "endGame", "player": 1, "victory": true}], "responses": [{"type": "disableControllers", "disable": true}, {"type": "chat", "sender": "LIEUTENANT HAYNE", "message": "Defeated again! I can't get my revenge this way. I must have it, though. I'll find it somewhere else. But where? Where! It's time to go now. Time to vanish.", "avatar": "hayne", "color": "FF0000FF"}, {"type": "chat", "sender": "CAPTAIN TUCKER", "message": "It's not just me, right? His brain is broken?", "avatar": "tucker", "color": "FFFF0000"}, {"type": "chat", "sender": "COMMANDER YURIK", "message": "It would seem that we are not his final objective. He appears to be after General Durand.", "avatar": "yurik", "color": "FF00FF00"}, {"type": "chat", "sender": "CAPTAIN TUCKER", "message": "The only thing I can think that would make a loyal soldier turn like that is something that destroys his faith in his commander.", "avatar": "tucker", "color": "FFFF0000"}, {"type": "chat", "sender": "COMMANDER YURIK", "message": "It would seem that your Captain Argent accomplished his mission after all.", "avatar": "yurik", "color": "FF00FF00"}, {"type": "chat", "sender": "CAPTAIN TUCKER", "message": "He must have shown Hayne the orders we uncovered of Durand calling for secret strikes on Akadian territory. On his own people.", "avatar": "tucker", "color": "FFFF0000"}, {"type": "chat", "sender": "COMMANDER YURIK", "message": "The attacks that started the Dragoon War, the war that drove my people from our homes at the hands of enraged Akadians. All an elaborate lie.", "avatar": "yurik", "color": "FF00FF00"}, {"type": "chat", "sender": "CAPTAIN TUCKER", "message": "Let's keep moving. I'd like to be very far away from Lieutenant Nutbar before he decides we're in his way again.", "avatar": "tucker", "color": "FFFF0000"}, {"type": "disableControllers", "disable": false}]}, {"conditions": [{"type": "endGame", "player": 1, "victory": false}], "responses": [{"type": "disableControllers", "disable": true}, {"type": "chat", "sender": "LIEUTENANT HAYNE", "message": "Yes! Victory. Durand will be next. Tucker and the Dragoons cannot steal my vengeance from me anymore.", "avatar": "hayne", "color": "FF0000FF"}, {"type": "disableControllers", "disable": false}]}]}}