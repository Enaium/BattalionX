FF0000FF"}, {"type": "createTransportedUnit", "x": 4, "y": 14, "player": 1, "transportType": "Heavy Commando", "transporterType": "Albatross Transport"}, {"type": "createTransportedUnit", "x": 5, "y": 14, "player": 1, "transportType": "Strike Commando", "transporterType": "Albatross Transport"}, {"type": "createTransportedUnit", "x": 6, "y": 14, "player": 1, "transportType": "Strike Commando", "transporterType": "Albatross Transport"}, {"type": "createTransportedUnit", "x": 7, "y": 14, "player": 1, "transportType": "Heavy Commando", "transporterType": "Albatross Transport"}, {"type": "chat", "sender": "GENERAL PEARL", "message": "Captain Tucker, you'll be leading these Commandos on a dangerous recovery mission. You have precious few actions before Mullen's forces realize what you're doing.", "avatar": "pearl", "color": "FFFF0000"}, {"type": "chat", "sender": "CAPTAIN TUCKER", "message": "Understood, sir!", "avatar": "tucker", "color": "FFFF0000"}, {"type": "highlight", "x": 6, "y": 9, "show": true, "updateCamera": false}, {"type": "highlight", "x": 5, "y": 10, "show": true, "updateCamera": false}, {"type": "highlight", "x": 7, "y": 10, "show": true, "updateCamera": false}, {"type": "highlight", "x": 6, "y": 11, "show": true, "updateCamera": false}, {"type": "chat", "sender": "GENERAL PEARL", "message": "Destroy any of these four Blockades to liberate the Warmachine. This is your priority objective.", "avatar": "pearl", "color": "FFFF0000"}, {"type": "highlight", "x": 6, "y": 9, "show": false, "updateCamera": false}, {"type": "highlight", "x": 5, "y": 10, "show": false, "updateCamera": false}, {"type": "highlight", "x": 7, "y": 10, "show": false, "updateCamera": false}, {"type": "highlight", "x": 6, "y": 11, "show": false, "updateCamera": false}, {"type": "highlight", "x": 6, "y": 10, "show": true, "updateCamera": false}, {"type": "chat", "sender": "GENERAL PEARL", "message": "Use the Warmachine's contruction ability to raise an army and crush Mullen's forces. Wipe that smirk off his face.", "avatar": "pearl", "color": "FFFF0000"}, {"type": "highlight", "x": 6, "y": 10, "show": false, "updateCamera": false}, {"type": "chat", "sender": "GENERAL PEARL", "message": "Click any unused unit twice to bring up its special actions menu.", "avatar": "pearl", "color": "FFFF0000"}, {"type": "chat", "sender": "GENERAL PEARL", "message": "Do this to deploy the flying Commandos so they can attack the Blockades, and to access the Warmachine's build menu when it has been freed.", "avatar": "pearl", "color": "FFFF0000"}, {"type": "chat", "sender": "GENERAL PEARL", "message": "Good luck, Captain Tucker! If you need additional help, check out the Quick Help section in the options menu on the right!", "avatar": "pearl", "color": "FFFF0000"}, {"type": "disableControllers", "disable": false}]}, {"conditions": [{"type": "endGame", "player": 1, "victory": true}], "responses": [{"type": "chat", "sender": "GENERAL PEARL", "message": "Congratulations on your victory!", "avatar": "pearl", "color": "FFFF0000"}, {"type": "chat", "sender": "GENERAL PEARL", "message": "If the Warmachine had fallen into Mullen's hands we would have had no hope against the coming Akadian offensive.", "avatar": "pearl", "color": "FFFF0000"}, {"type": "chat", "sender": "GENERAL PEARL", "message": "Now, we can lay a trap for those Akadian bastards and turn the tide of the war against them.", "avatar": "pearl", "color": "FFFF0000"}]}, {"conditions": [{"type": "endGame", "player": 1, "victory": false}], "responses": [{"type": "chat", "sender": "GENERAL PEARL", "message": "The Warmachine is lost. Without this prototype we have no weapon to stem the tide against the Akadian onslaught.", "avatar": "pearl", "color": "FFFF0000"}]}]}}