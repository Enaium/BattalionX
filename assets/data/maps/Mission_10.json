ype": "enableUnit", "player": 1, "enable": true, "unit": "Lancer Tank"}, {"type": "enableUnit", "player": 1, "enable": true, "unit": "Vulture Drone"}, {"type": "enableUnit", "player": 1, "enable": true, "unit": "Hunter Support"}, {"type": "enableUnit", "player": 1, "enable": true, "unit": "Intrepid"}, {"type": "enableUnit", "player": 1, "enable": true, "unit": "Corvette Fighter"}, {"type": "enableUnit", "player": 1, "enable": true, "unit": "Battlecruiser"}, {"type": "enableUnit", "player": 1, "enable": true, "unit": "U-Boat"}, {"type": "disableAllUnits", "player": 2, "disable": true}, {"type": "enableUnit", "player": 2, "enable": true, "unit": "Spider Tank"}, {"type": "enableUnit", "player": 2, "enable": true, "unit": "Strike Commando"}, {"type": "enableUnit", "player": 2, "enable": true, "unit": "Heavy Commando"}, {"type": "enableUnit", "player": 2, "enable": true, "unit": "Flak Tank"}, {"type": "enableUnit", "player": 2, "enable": true, "unit": "Scorpion Tank"}, {"type": "enableUnit", "player": 2, "enable": true, "unit": "Mortar Truck"}, {"type": "enableUnit", "player": 2, "enable": true, "unit": "Rocket Truck"}, {"type": "enableUnit", "player": 2, "enable": true, "unit": "Stealth Tank"}, {"type": "enableUnit", "player": 2, "enable": true, "unit": "Annihilator Tank"}, {"type": "enableUnit", "player": 2, "enable": true, "unit": "Condor Bomber"}, {"type": "enableUnit", "player": 2, "enable": true, "unit": "Raptor Fighter"}, {"type": "enableUnit", "player": 2, "enable": true, "unit": "Hunter Support"}, {"type": "enableUnit", "player": 2, "enable": true, "unit": "Intrepid"}, {"type": "enableUnit", "player": 2, "enable": true, "unit": "Corvette Fighter"}, {"type": "enableUnit", "player": 2, "enable": true, "unit": "Battlecruiser"}, {"type": "enableUnit", "player": 2, "enable": true, "unit": "U-Boat"}, {"type": "enableUnit", "player": 2, "enable": true, "unit": "Lancer Tank"}, {"type": "enableUnit", "player": 2, "enable": true, "unit": "Vulture Drone"}, {"type": "chat", "sender": "COMMANDER YURIK", "message": "We are here.", "avatar": "yurik", "color": "FF00FF00"}, {"type": "chat", "sender": "CAPTAIN TUCKER", "message": "Hayne's secret pathway did its job. All that's left is the final stronghold for Durand.", "avatar": "tucker", "color": "FFFF0000"}, {"type": "chat", "sender": "LIEUTENANT HAYNE", "message": "We've got to end this.", "avatar": "hayne", "color": "FF0000FF"}, {"type": "chat", "sender": "COMMANDER YURIK", "message": "How is it that you are silent, Argent?", "avatar": "yurik", "color": "FF00FF00"}, {"type": "chat", "sender": "CAPTAIN ARGENT", "message": "This has been a long time coming for all of us. I'll be able to laugh about this one once it's all over.", "avatar": "argent", "color": "FFFF0000"}, {"type": "chat", "sender": "GENERAL DURAND", "message": "Hayne. So it's true? You're a traitor. I did not expect you all so soon, which means he must have led you through our private pathways.", "avatar": "evil_durand", "color": "FF0000FF"}, {"type": "chat", "sender": "LIEUTENANT HAYNE", "message": "Traitor? Ironic, coming from you.", "avatar": "hayne", "color": "FF0000FF"}, {"type": "chat", "sender": "GENERAL DURAND", "message": "I never thought I'd have to kill you, Hayne. I almost feel bad about it.", "avatar": "evil_durand", "color": "FF0000FF"}, {"type": "chat", "sender": "COMMANDER YURIK", "message": "Your time is over, Durand. Today will begin a new era, and the Dragoons will return to our home.", "avatar": "yurik", "color": "FF00FF00"}, {"type": "chat", "sender": "GENERAL DURAND", "message": "Are you sure about that?", "avatar": "evil_durand", "color": "FF0000FF"}, {"type": "scroll", "x": 15, "y": 15}, {"type": "chat", "sender": "CAPTAIN ARGENT", "message": "Lancers and Vultures! What the heck?! I just made that like a week ago and you already stole it. Dang, man. That's cold.", "avatar": "argent", "color": "FF00FF00"}, {"type": "chat", "sender": "GENERAL DURAND", "message": "My spies are busy little bees. What can I say?", "avatar": "evil_durand", "color": "FF0000FF"}, {"type": "chat", "sender": "CAPTAIN TUCKER", "message": "Enough. We're done with your tricks Durand. We're going to put an end to you.", "avatar": "tucker", "color": "FFFF0000"}, {"type": "scroll", "x": 0, "y": 0}, {"type": "disableControllers", "disable": false}]}, {"conditions": [{"type": "endGame", "player": 1, "victory": true}], "responses": [{"type": "disableControllers", "disable": true}, {"type": "chat", "sender": "GENERAL DURAND", "message": "I suppose you think you've won.", "avatar": "evil_durand", "color": "FF0000FF"}, {"type": "chat", "sender": "COMMANDER YURIK", "message": "Our victory is clear. None of your defenses remain.", "avatar": "yurik", "color": "FF00FF00"}, {"type": "chat", "sender": "CAPTAIN ARGENT", "message": "In your FACE.", "avatar": "argent", "color": "FFFF0000"}, {"type": "chat", "sender": "CAPTAIN TUCKER", "message": "Your people will know what you've done Durand. They'll know they've spent years living in a wasteland due to the aftermath of a war you started. They will never accept you again.", "avatar": "tucker", "color": "FFFF0000"}, {"type": "chat", "sender": "GENERAL DURAND", "message": "Just execute me if there is nothing left for me.", "avatar": "evil_durand", "color": "FF0000FF"}, {"type": "chat", "sender": "CAPTAIN TUCKER", "message": "You will go to prison as punishment for your crimes. Everyone will see what becomes of men like you.", "avatar": "tucker", "color": "FFFF0000"}, {"type": "chat", "sender": "GENERAL DURAND", "message": "Exactly. As long as I breathe, you will never have won. Never.", "avatar": "evil_durand", "color": "FF0000FF"}, {"type": "chat", "sender": "CAPTAIN ARGENT", "message": "Get his sorry butt out of here! I'm tired of hearing him yap. You got schooled, chump! Schooled hard!", "avatar": "argent", "color": "FFFF0000"}, {"type": "chat", "sender": "GENERAL PEARL", "message": "Did I miss the whole party?", "avatar": "pearl", "color": "FFFF0000"}, {"type": "chat", "sender": "COMMANDER YURIK", "message": "We did not have a party. Today we had a glorious battle.", "avatar": "yurik", "color": "FF00FF00"}, {"type": "chat", "sender": "CAPTAIN TUCKER", "message": "No sarcasm.", "avatar": "tucker", "color": "FF00FF00"}, {"type": "chat", "sender": "GENERAL PEARL", "message": "I always forget they're no good at that. Well, I'm proud of you boys. You did a fine job.", "avatar": "pearl", "color": "FF00FF00"}, {"type": "chat", "sender": "CAPTAIN ARGENT", "message": "I don't know about you guys, but when I feel proud of someone, I like to shower them with cash. Lots and lots of cash. I'll be right over here when you're ready to start throwing stacks of money at me.", "avatar": "argent", "color": "FFFF0000"}, {"type": "chat", "sender": "CAPTAIN TUCKER", "message": "Welcome home, Yurik. It will be nice to have our old neighbors back where they belong.", "avatar": "tucker", "color": "FFFF0000"}, {"type": "chat", "sender": "COMMANDER YURIK", "message": "You have done a brave thing, Tucker. You have risked your life in our cause. This makes us brothers.", "avatar": "yurik", "color": "FF00FF00"}, {"type": "chat", "sender": "CAPTAIN ARGENT", "message": "Still waiting for my cash shower...", "avatar": "argent", "color": "FFFF0000"}, {"type": "chat", "sender": "CAPTAIN TUCKER", "message": "I'm pretty sure there are some Northern Fed parades waiting for you to be Grand Marshall of, Argent? Will you accept fame and an adoring nation instead of cash?", "avatar": "tucker", "color": "FFFF0000"}, {"type": "chat", "sender": "CAPTAIN ARGENT", "message": "I could be persuaded. Will there be groupies?", "avatar": "argent", "color": "FFFF0000"}, {"type": "chat", "sender": "GENERAL PEARL", "message": "Get out of here, all of you! Go! Go be heroes! You've earned it.", "avatar": "pearl", "color": "FFFF0000"}, {"type": "disableControllers", "disable": false}]}, {"conditions": [{"type": "endGame", "player": 1, "victory": false}], "responses": [{"type": "disableControllers", "disable": true}, {"type": "chat", "sender": "GENERAL DURAND", "message": "Could there have been any other outcome? I hate seeing someone waste their time the way those fools did.", "avatar": "evil_durand", "color": "FF0000FF"}, {"type": "disableControllers", "disable": false}]}]}}